---
// Gartha's photo inside a chalk outline, with a set of chalk doodles around
// it. The doodle sets are the "characters": the arrows below swap between
// them (wired by scripts/character-select.ts).
//
// Motion: on load the outline, stars and first doodle set draw themselves in,
// one doodle after another (each group's --d sets its delay). After that the
// doodles float gently, the stars twinkle and the dashed lines drift. Swapping
// sets redraws the doodles, hops the photo and rewrites the label.
const sets = [
  { key: "programmer", name: "programmer" },
  { key: "gamer", name: "gamer" },
] as const;
const stars: [number, number, number][] = [
  [150, 36, 0.9], [36, 232, 1.1], [116, 470, 0.8], [552, 236, 1], [520, 60, 0.7],
  [568, 430, 0.9], [176, 600, 1], [430, 612, 0.8], [250, 20, 0.6], [24, 560, 0.7],
];
---
<div class="stage" data-character-select role="group" aria-roledescription="character select" aria-label="Choose who shows up today">
  <div class="board" data-board>
    <svg class="layer static" viewBox="0 0 600 640" aria-hidden="true">
      {stars.map(([x, y, s], i) => (
        <g transform={`translate(${x} ${y}) scale(${s})`}>
          <path class="star" style={`--t:${(i * 0.37) % 2.4}s;--d:${0.9 + i * 0.08}s`} d="M0 -9 V9 M-9 0 H9 M-6 -6 L6 6 M6 -6 L-6 6" />
        </g>
      ))}
      <path class="outline" pathLength="1" d="M300 30 C 362 26 404 72 407 150 C 413 262 399 420 409 540 C 415 602 370 627 300 624 C 228 627 190 600 193 540 C 201 420 187 262 195 150 C 199 72 240 33 300 30 Z" />
      <path class="outline faint" pathLength="1" d="M292 36 C 350 28 398 70 401 152 C 405 266 395 416 403 538 C 407 596 368 618 302 618" />
    </svg>

    <img class="me" src="/gartha.webp" alt="Gartha standing in a winter jacket, hands in pockets" width="271" height="826" fetchpriority="high" />

    {sets.map((set, i) => (
      <div class="slide" data-slide data-name={set.name} hidden={i !== 0}>
        <svg class="layer" viewBox="0 0 600 640" aria-hidden="true">
          {set.key === "programmer" ? (
            <Fragment>
              <g class="float" style="--d:.5s;--f:5.5s">
                <g transform="translate(36 86) scale(1.35)">
                  <path pathLength="1" d="M13 6 H67 Q70 6 70 9 V44 H10 V9 Q10 6 13 6 Z" />
                  <path pathLength="1" d="M2 44 H78 L72 53 H8 Z" />
                  <path pathLength="1" d="M33 18 L26 25 L33 32 M47 18 L54 25 L47 32 M43 15 L37 35" />
                </g>
              </g>
              <path class="dash" style="--d:.9s" d="M150 150 C 176 166 168 198 196 210" />

              <g class="float" style="--d:.7s;--f:6.5s">
                <g transform="translate(64 318) scale(1.15)">
                  <path pathLength="1" d="M10 24 H48 V44 Q48 58 34 58 H24 Q10 58 10 44 Z" />
                  <path pathLength="1" d="M48 30 H53 Q61 30 61 37 Q61 44 53 44 H48" />
                  <path pathLength="1" class="steam" d="M20 18 C 16 13 24 10 20 4 M30 18 C 26 13 34 10 30 4 M40 18 C 36 13 44 10 40 4" />
                  <path pathLength="1" class="hatch" d="M14 34 L22 28 M16 42 L30 30 M20 50 L38 32 M28 54 L44 38" />
                </g>
              </g>
              <path class="string" pathLength="1" style="--d:1.1s" d="M142 372 C 164 380 172 352 194 356" />

              <g class="float" style="--d:.9s;--f:5s">
                <text x="456" y="124" class="word">{"{ }"}</text>
              </g>
              <path class="string" pathLength="1" style="--d:1.2s" d="M406 190 C 424 186 420 158 436 150 C 452 142 458 166 444 168 C 432 170 438 140 456 132" />

              <g class="float" style="--d:1.1s;--f:6s">
                <g transform="translate(446 290) scale(1.3)">
                  <path pathLength="1" d="M6 6 H70 Q74 6 74 10 V50 Q74 54 70 54 H10 Q6 54 6 50 Z" />
                  <path pathLength="1" d="M6 16 H74 M14 11 h1 M20 11 h1 M26 11 h1" />
                  <path pathLength="1" d="M16 26 L24 32 L16 38" />
                  <path class="cursor" d="M30 42 H44" />
                </g>
              </g>
              <path class="dash" style="--d:1.4s" d="M408 330 C 424 316 434 338 446 328" />

              <g class="float" style="--d:1.3s;--f:7s">
                <g transform="translate(430 488)">
                  <path pathLength="1" d="M26 58 Q8 58 9 44 Q10 32 24 32 Q26 14 46 13 Q64 12 70 30 Q88 30 88 45 Q88 58 72 58 Z" />
                  <path pathLength="1" class="bolt" d="M50 26 L42 40 H52 L44 54" />
                </g>
                <text x="452" y="586" class="note">workers</text>
              </g>
              <path class="dash" style="--d:1.6s" d="M404 560 C 420 584 436 566 446 548" />
            </Fragment>
          ) : (
            <Fragment>
              <g class="float" style="--d:.5s;--f:5.5s">
                <g transform="translate(30 92) scale(1.3)">
                  <path pathLength="1" d="M24 12 H66 C 78 12 86 22 88 36 C 90 48 80 54 72 46 L64 38 H26 L18 46 C 10 54 0 48 2 36 C 4 22 12 12 24 12 Z" />
                  <path pathLength="1" d="M24 20 V34 M17 27 H31" />
                  <path pathLength="1" class="blink" d="M62 22 a3 3 0 1 0 0.1 0 M70 29 a3 3 0 1 0 0.1 0" />
                </g>
              </g>
              <path class="dash" style="--d:.9s" d="M150 150 C 176 166 168 198 196 210" />

              <g class="float" style="--d:.7s;--f:6.5s">
                <g transform="translate(60 316) scale(1.15)">
                  <g class="beat">
                    <path pathLength="1" d="M30 58 C 8 42 6 24 16 17 C 23 12 28 16 30 22 C 32 16 37 12 44 17 C 54 24 52 42 30 58 Z" />
                    <path pathLength="1" class="hatch" d="M18 26 L26 20 M18 34 L34 22 M24 40 L40 26 M30 46 L44 34" />
                  </g>
                </g>
                <text x="78" y="414" class="note">hp 100</text>
              </g>
              <path class="string" pathLength="1" style="--d:1.1s" d="M142 372 C 164 380 172 352 194 356" />

              <g class="float" style="--d:.9s;--f:5s">
                <g transform="translate(452 70) scale(1.25)">
                  <path pathLength="1" d="M16 8 H44 V24 Q44 38 30 38 Q16 38 16 24 Z" />
                  <path pathLength="1" d="M16 12 H9 Q4 12 5 18 Q7 26 16 26 M44 12 H51 Q56 12 55 18 Q53 26 44 26" />
                  <path pathLength="1" d="M30 38 V48 M20 60 H40 L37 48 H23 Z" />
                  <path pathLength="1" d="M30 15 L32 20 H37 L33 23 L34.5 28 L30 25 L25.5 28 L27 23 L23 20 H28 Z" />
                </g>
              </g>
              <path class="string" pathLength="1" style="--d:1.2s" d="M406 190 C 424 186 420 158 436 150 C 452 142 458 166 444 168 C 432 170 438 140 456 132" />

              <g class="float" style="--d:1.1s;--f:6s">
                <text x="464" y="354" class="word">GG</text>
              </g>
              <path class="dash" style="--d:1.4s" d="M408 330 C 424 316 434 338 452 334" />

              <g class="float" style="--d:1.3s;--f:7s">
                <g transform="translate(446 486)">
                  <path pathLength="1" d="M20 60 H76 L70 46 H26 Z" />
                  <g class="wiggle">
                    <path pathLength="1" d="M48 46 V22" />
                    <path pathLength="1" d="M48 6 a9 9 0 1 0 0.1 0" />
                  </g>
                  <path pathLength="1" d="M60 54 a3 3 0 1 0 0.1 0" />
                </g>
                <text x="452" y="590" class="note">ranked</text>
              </g>
              <path class="dash" style="--d:1.6s" d="M404 560 C 420 584 436 566 452 552" />
            </Fragment>
          )}
        </svg>
      </div>
    ))}
  </div>

  <div class="picker">
    <button class="arrow" type="button" data-step="-1" aria-label="Previous">
      <svg width="34" height="22" viewBox="0 0 34 22" aria-hidden="true"><path d="M32 12 C 22 10 12 11 3 11 M10 3 L2 11 L10 19" /></svg>
    </button>
    <span class="display label" data-character-label aria-live="polite">{sets[0].name}</span>
    <button class="arrow" type="button" data-step="1" aria-label="Next">
      <svg width="34" height="22" viewBox="0 0 34 22" aria-hidden="true"><path d="M2 10 C 12 12 22 11 31 11 M24 3 L32 11 L24 19" /></svg>
    </button>
  </div>
</div>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <filter id="chalk-rough">
    <feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="2" seed="4" />
    <feDisplacementMap in="SourceGraphic" scale="2.6" />
  </filter>
</svg>

<script>
  import { initCharacterSelect } from "../scripts/character-select";

  const root = document.querySelector<HTMLElement>("[data-character-select]");
  if (root) {
    initCharacterSelect(root);
    // Replay the swap animation (photo hop, label rewrite) on every change.
    const board = root.querySelector<HTMLElement>("[data-board]");
    const swap = () => {
      root.classList.remove("swapped");
      void root.offsetWidth;
      root.classList.add("swapped");
    };
    for (const b of root.querySelectorAll("[data-step]")) b.addEventListener("click", swap);
    root.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight" || e.key === "ArrowLeft") swap();
    });
    board?.classList.add("ready");
  }
</script>

<style>
  .stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }
  .board {
    position: relative;
    width: 100%;
    max-width: 600px;
    aspect-ratio: 600 / 640;
  }
  .layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke: var(--chalk);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: url(#chalk-rough) drop-shadow(0 0 1px rgba(243, 241, 231, 0.35));
    -webkit-mask-image: var(--grain);
    mask-image: var(--grain);
  }

  /* Outline: drawn once when the page opens. */
  .outline {
    stroke-width: 3;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 1.6s cubic-bezier(0.6, 0, 0.3, 1) 0.1s forwards;
  }
  .outline.faint {
    stroke-width: 1.6;
    opacity: 0.4;
    animation-delay: 0.6s;
  }

  /* Stars pop in, then twinkle at their own pace. */
  .star {
    stroke-width: 2;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation:
      pop 0.5s ease-out var(--d) forwards,
      twinkle 2.8s ease-in-out calc(var(--d) + 0.5s + var(--t)) infinite;
  }

  .me {
    position: absolute;
    left: 50%;
    top: 7.5%;
    height: 87%;
    width: auto;
    transform: translateX(-50%);
    filter: drop-shadow(0 10px 18px rgba(0, 0, 0, 0.45));
    animation: rise 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) 0.2s both;
  }
  .swapped .me {
    animation: hop 0.5s cubic-bezier(0.3, 1.6, 0.5, 1);
  }

  .slide {
    position: absolute;
    inset: 0;
    z-index: 2;
  }
  .hatch {
    stroke-width: 1.4;
    opacity: 0.6;
  }
  .dash {
    stroke-dasharray: 4 8;
    opacity: 0.8;
  }
  .string {
    stroke-width: 1.8;
    opacity: 0.85;
  }
  .word {
    fill: var(--chalk);
    stroke: none;
    font-family: var(--font-display);
    font-size: 54px;
  }
  .note {
    fill: var(--yellow);
    stroke: none;
    font-family: var(--font-hand);
    font-size: 24px;
  }

  /* Doodles draw in one after another, then float. */
  .slide:not([hidden]) path[pathLength] {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 0.9s ease-out var(--d, 0s) forwards;
  }
  .slide:not([hidden]) text,
  .slide:not([hidden]) .cursor {
    animation: appear 0.6s ease-out calc(var(--d, 0s) + 0.35s) both;
  }
  .slide:not([hidden]) .dash {
    animation:
      appear 0.5s ease-out var(--d, 0s) both,
      drift 1.6s linear calc(var(--d, 0s) + 0.5s) infinite;
  }
  .slide:not([hidden]) .float {
    animation: bob var(--f, 6s) ease-in-out calc(var(--d, 0s) + 1s) infinite;
  }

  /* Small details that keep each doodle alive. */
  .slide:not([hidden]) .cursor {
    animation:
      appear 0.6s ease-out calc(var(--d, 0s) + 0.35s) both,
      blink 1.1s steps(1) calc(var(--d, 0s) + 1s) infinite;
  }
  .slide:not([hidden]) .steam {
    animation:
      draw 0.9s ease-out var(--d, 0s) forwards,
      steam 2.4s ease-in-out calc(var(--d, 0s) + 1s) infinite;
  }
  .slide:not([hidden]) .bolt {
    animation:
      draw 0.9s ease-out var(--d, 0s) forwards,
      flash 3.2s ease-in-out calc(var(--d, 0s) + 1.2s) infinite;
  }
  .slide:not([hidden]) .beat {
    transform-box: fill-box;
    transform-origin: center;
    animation: beat 1.4s ease-in-out calc(var(--d, 0s) + 1s) infinite;
  }
  .slide:not([hidden]) .wiggle {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: wiggle 2.6s ease-in-out calc(var(--d, 0s) + 1s) infinite;
  }
  .slide:not([hidden]) .blink {
    animation:
      draw 0.9s ease-out var(--d, 0s) forwards,
      flash 2s ease-in-out calc(var(--d, 0s) + 1s) infinite;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes appear {
    from {
      opacity: 0;
    }
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(0.2) rotate(-45deg);
    }
    to {
      opacity: 0.75;
      transform: none;
    }
  }
  @keyframes twinkle {
    0%,
    100% {
      opacity: 0.75;
      transform: none;
    }
    50% {
      opacity: 0.25;
      transform: scale(0.75) rotate(20deg);
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translate(-50%, 18px);
    }
  }
  @keyframes hop {
    0% {
      transform: translate(-50%, 0);
    }
    40% {
      transform: translate(-50%, -14px) rotate(-1.5deg);
    }
    100% {
      transform: translate(-50%, 0);
    }
  }
  @keyframes bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }
  @keyframes drift {
    to {
      stroke-dashoffset: -12;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @keyframes steam {
    0%,
    100% {
      opacity: 1;
      transform: translateY(0);
    }
    50% {
      opacity: 0.4;
      transform: translateY(-3px);
    }
  }
  @keyframes flash {
    0%,
    100% {
      stroke: var(--chalk);
    }
    50% {
      stroke: var(--yellow);
    }
  }
  @keyframes beat {
    0%,
    100% {
      transform: scale(1);
    }
    15% {
      transform: scale(1.12);
    }
    30% {
      transform: scale(1);
    }
    45% {
      transform: scale(1.08);
    }
  }
  @keyframes wiggle {
    0%,
    100% {
      transform: rotate(0);
    }
    25% {
      transform: rotate(-12deg);
    }
    75% {
      transform: rotate(12deg);
    }
  }

  .picker {
    display: flex;
    align-items: center;
    gap: 18px;
    animation: appear 0.6s ease-out 1.4s both;
  }
  .label {
    min-width: 7.5ch;
    text-align: center;
    font-size: 34px;
    color: var(--chalk);
    text-shadow: var(--chalk-glow);
  }
  /* The label gets rewritten left to right, like chalk. */
  .swapped .label {
    animation: write 0.55s ease-out;
  }
  @keyframes write {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  .arrow {
    display: grid;
    place-items: center;
    width: 52px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--chalk-2);
    cursor: pointer;
    transition: color 0.15s ease, transform 0.15s ease;
  }
  .arrow svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .arrow:hover {
    color: var(--yellow);
  }
  .arrow[data-step="-1"]:hover {
    transform: translateX(-4px);
  }
  .arrow[data-step="1"]:hover {
    transform: translateX(4px);
  }
  .arrow:active {
    transform: scale(0.9);
  }

  @media (prefers-reduced-motion: reduce) {
    .outline,
    .slide:not([hidden]) path[pathLength] {
      stroke-dashoffset: 0;
    }
    .star {
      opacity: 0.75;
    }
  }
</style>
