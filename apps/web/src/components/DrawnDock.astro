---
// Floating navigation at the bottom of the board, drawn in chalk:
// - the dock's outline draws itself when the page opens, and redraws around
//   the new shape whenever a tray opens or closes (scripts/chalk-outline.ts);
// - page names write themselves in letter by letter;
// - the current page gets a chalk circle scribbled around it as you watch.
// Pressing the page name opens the page list, the two-line button opens the
// links tray. Open/close behaviour lives in scripts/dock.ts.
import { Logo } from "@gartha/ui";
import { socials } from "../data/profile";

export type PageKey = "home" | "blog" | "projects" | "about";
interface Props {
  active: PageKey;
}
const pages: { key: PageKey; href: string; label: string; note: string }[] = [
  { key: "home", href: "/", label: "Home", note: "the board" },
  { key: "blog", href: "/blog", label: "Blog", note: "notes & write-ups" },
  { key: "projects", href: "/projects", label: "Projects", note: "things I've built" },
  { key: "about", href: "/about", label: "About", note: "who's writing this" },
];
const { active } = Astro.props;
const current = pages.find((p) => p.key === active)?.label ?? "Home";
const isHome = Astro.url.pathname === "/";
const letters = (text: string) => [...text];
---
<div class="dock-fade" aria-hidden="true"></div>
<div class="dock-wrap">
  <nav class="dock" data-dock data-drawn-dock data-open="" aria-label="Site">
    <svg class="outline" aria-hidden="true">
      <path class="pass" pathLength="1" data-outline />
      <path class="pass faint" pathLength="1" data-outline />
    </svg>

    <div class="panel">
      <div class="panel-inner">
        <ul class="pages" id="dock-pages" data-panel="pages">
          {pages.map((p, row) => (
            <li style={`--row:${row}`}>
              <a href={p.href} aria-current={p.key === active ? "page" : undefined}>
                <span class="display name">
                  <span class="sr-only">{p.label}</span>
                  <span aria-hidden="true">
                    {letters(p.label).map((ch, k) => <span class="ch" style={`--k:${k}`}>{ch}</span>)}
                  </span>
                  {p.key === active && (
                    <svg class="circle" viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true">
                      <path pathLength="1" d="M10 26 C 4 10 44 3 78 6 C 99 9 99 31 62 36 C 30 40 3 35 6 21 C 9 11 32 5 50 5" />
                    </svg>
                  )}
                </span>
                <span class="note hand">{p.note}</span>
              </a>
            </li>
          ))}
        </ul>
        <div class="more" id="dock-more" data-panel="more">
          <p class="mono kicker">find me elsewhere</p>
          <ul>
            {socials.map((s, row) => (
              <li style={`--row:${row}`}>
                <a href={s.href} rel={s.href.startsWith("http") ? "me noopener" : undefined}>
                  <span class="hand">{s.label}</span><span aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="mono sign">© {new Date().getFullYear()} Gartha · written in chalk</p>
        </div>
      </div>
    </div>

    <div class="bar">
      {isHome ? (
        <a class="icon" href="/" aria-label="gartha.me home"><Logo size={30} label="" /></a>
      ) : (
        <button class="icon" type="button" data-back aria-label="Back">
          <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path pathLength="1" d="M20 12.5 C 15 11.5 10 12 4.5 12 M11 5 L4 12 L11 19" /></svg>
        </button>
      )}
      <button class="current" type="button" data-tray="pages" aria-controls="dock-pages" aria-expanded="false" aria-label={`${current}, open pages`}>
        <span class="display word" aria-hidden="true">
          {letters(current).map((ch, k) => <span class="ch" style={`--k:${k}`}>{ch}</span>)}
        </span>
        <svg class="caret" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 9 L7 5 L11 9" /></svg>
      </button>
      <button class="icon burger" type="button" data-tray="more" aria-controls="dock-more" aria-expanded="false" aria-label="More">
        <span></span><span></span>
      </button>
    </div>
  </nav>
</div>

<script>
  import { initDock } from "../scripts/dock";
  import { traceOutline } from "../scripts/chalk-outline";

  const root = document.querySelector<HTMLElement>("[data-drawn-dock]");
  if (root) {
    initDock(root);
    for (const path of root.querySelectorAll<SVGPathElement>("[data-outline]")) traceOutline(root, path, 24);
    // Redraw the outline around the dock's new shape each time it opens or closes.
    let last = root.dataset.open;
    new MutationObserver(() => {
      if (root.dataset.open === last) return;
      last = root.dataset.open;
      root.classList.remove("redraw");
      void root.getBoundingClientRect();
      root.classList.add("redraw");
    }).observe(root, { attributes: true, attributeFilter: ["data-open"] });
  }
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .dock-fade {
    position: fixed;
    inset: auto 0 0;
    height: 120px;
    z-index: 40;
    pointer-events: none;
    background: linear-gradient(to bottom, transparent, rgba(30, 34, 32, 0.85));
  }
  .dock-wrap {
    position: fixed;
    inset: auto 0 calc(16px + env(safe-area-inset-bottom));
    z-index: 50;
    display: flex;
    justify-content: center;
    padding: 0 16px;
    pointer-events: none;
  }
  .dock {
    position: relative;
    pointer-events: auto;
    width: 250px;
    max-width: 100%;
    border-radius: 24px;
    background: rgba(36, 41, 39, 0.95);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45);
    transition: width 0.45s cubic-bezier(0.3, 1.3, 0.5, 1);
    animation: dd-dock-in 0.6s ease-out 0.15s both;
  }
  .dock:not([data-open=""]) {
    width: 340px;
  }

  /* The chalk outline, drawn rather than bordered. */
  .outline {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    fill: none;
    stroke: var(--chalk);
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: drop-shadow(0 0 1px rgba(243, 241, 231, 0.4));
    -webkit-mask-image: var(--grain);
    mask-image: var(--grain);
  }
  .pass {
    stroke-width: 2.4;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: dd-draw 1.1s cubic-bezier(0.6, 0, 0.3, 1) 0.35s forwards;
  }
  .pass.faint {
    stroke-width: 1.3;
    opacity: 0.4;
    transform: translate(1.5px, 1px);
    animation-delay: 0.6s;
  }
  .redraw .pass {
    animation: dd-draw 0.6s cubic-bezier(0.6, 0, 0.3, 1) forwards;
  }
  .redraw .pass.faint {
    animation-delay: 0.12s;
  }

  .panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.45s cubic-bezier(0.3, 1.15, 0.5, 1);
  }
  .dock:not([data-open=""]) .panel {
    grid-template-rows: 1fr;
  }
  .panel-inner {
    min-height: 0;
    overflow: hidden;
  }
  [data-panel] {
    display: none;
    margin: 0;
    padding: 18px 18px 6px;
    list-style: none;
  }
  .dock[data-open="pages"] [data-panel="pages"],
  .dock[data-open="more"] [data-panel="more"] {
    display: block;
  }
  [data-panel] li {
    list-style: none;
  }

  .pages a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 12px;
    border-radius: 14px;
    color: var(--chalk);
    text-decoration: none;
    transition: background-color 0.2s ease;
  }
  .pages a:hover {
    background: rgba(243, 241, 231, 0.06);
    color: var(--chalk);
  }
  .pages .name {
    position: relative;
    font-size: 28px;
    line-height: 1.1;
    text-shadow: var(--chalk-glow);
  }
  .pages a:hover .name,
  .pages a[aria-current="page"] .name {
    color: var(--yellow);
  }
  .pages .note {
    font-size: 17px;
    color: var(--chalk-3);
  }
  .dock[data-open="pages"] .note {
    animation: dd-fade 0.4s ease-out calc(0.25s + var(--row) * 0.08s) both;
  }

  /* Letters write in one by one, row after row. */
  .ch {
    display: inline-block;
    white-space: pre;
  }
  .dock[data-open="pages"] .pages .ch {
    animation: dd-letter 0.3s ease-out calc(0.12s + var(--row) * 0.08s + var(--k) * 0.035s) both;
  }

  /* "You are here", scribbled once the letters are down. */
  .circle {
    position: absolute;
    inset: -6px -16px -8px -14px;
    width: calc(100% + 30px);
    height: calc(100% + 14px);
    overflow: visible;
    fill: none;
    stroke: var(--yellow);
    stroke-width: 2.2;
    stroke-linecap: round;
    pointer-events: none;
  }
  .circle path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .dock[data-open="pages"] .circle path {
    animation: dd-draw 0.55s ease-in-out calc(0.45s + var(--row) * 0.08s) forwards;
  }

  .more .kicker {
    margin: 0 0 6px 12px;
    font-size: 14px;
    color: var(--chalk-3);
  }
  .more ul {
    margin: 0;
    padding: 0;
  }
  .more a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    border-radius: 14px;
    color: var(--chalk);
    font-size: 24px;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }
  .more a:hover {
    background: rgba(243, 241, 231, 0.06);
    color: var(--yellow);
  }
  .more .sign {
    margin: 10px 12px 6px;
    font-size: 13px;
    color: var(--chalk-3);
  }
  .dock[data-open="more"] .more li {
    animation: dd-write 0.45s ease-out calc(0.15s + var(--row) * 0.1s) both;
  }
  .dock[data-open="more"] .more .kicker,
  .dock[data-open="more"] .more .sign {
    animation: dd-fade 0.4s ease-out 0.1s both;
  }

  .bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 4px;
    height: 54px;
    padding: 5px;
    box-sizing: border-box;
  }
  .icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--chalk-2);
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
    --logo-accent: var(--teal);
    animation: dd-fade 0.4s ease-out 1.1s both;
  }
  .icon:hover {
    background: rgba(243, 241, 231, 0.08);
    color: var(--yellow);
  }
  .icon svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .current {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 44px;
    padding: 0 14px;
    border: 0;
    border-radius: 22px;
    background: none;
    color: var(--chalk);
    font-size: 22px;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  .current:hover {
    background: rgba(243, 241, 231, 0.07);
  }
  .word {
    text-shadow: var(--chalk-glow);
  }
  .word .ch {
    animation: dd-letter 0.3s ease-out calc(0.9s + var(--k) * 0.06s) both;
  }
  .caret {
    flex-shrink: 0;
    fill: none;
    stroke: var(--chalk-3);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.35s ease;
    animation: dd-fade 0.4s ease-out 1.3s both;
  }
  .dock[data-open="pages"] .caret {
    transform: rotate(180deg);
  }

  /* Two chalk lines that cross into an X when the links tray is open. */
  .burger {
    position: relative;
  }
  .burger span {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 19px;
    height: 2.4px;
    margin: -1.2px 0 0 -9.5px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.35s cubic-bezier(0.3, 1.4, 0.5, 1);
  }
  .burger span:first-child {
    transform: translateY(-3.5px);
  }
  .burger span:last-child {
    transform: translateY(3.5px);
  }
  .dock[data-open="more"] .burger span:first-child {
    transform: rotate(45deg);
  }
  .dock[data-open="more"] .burger span:last-child {
    transform: rotate(-45deg);
  }

  @keyframes dd-dock-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
  @keyframes dd-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes dd-letter {
    from {
      opacity: 0;
      transform: translateY(5px) rotate(-6deg);
      filter: blur(2px);
    }
  }
  @keyframes dd-write {
    from {
      clip-path: inset(-20% 100% -20% 0);
    }
    to {
      clip-path: inset(-20% -5% -20% 0);
    }
  }
  @keyframes dd-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pass,
    .circle path {
      stroke-dashoffset: 0;
    }
  }
</style>
