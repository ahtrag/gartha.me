---
// The navigation is the chalk ledge at the bottom of the board: a wooden tray
// holding one stick of chalk per page and a felt eraser.
// - Each stick is a page link, with its name chalked above it. The current
//   page's stick is worn short and propped up, its name in yellow.
// - Picking a stick scribbles across the board before the next page loads
//   (scripts/scribble-nav.ts).
// - The eraser wipes a patch of the board clean and writes the links tray
//   into it (open/close handled by scripts/dock.ts).
import { socials } from "../data/profile";

export type PageKey = "home" | "blog" | "projects" | "about";
interface Props {
  active: PageKey;
}
const sticks: { key: PageKey; href: string; label: string; color: string; len: number; tilt: number }[] = [
  { key: "home", href: "/", label: "home", color: "var(--chalk)", len: 78, tilt: -2 },
  { key: "blog", href: "/blog", label: "blog", color: "var(--sky)", len: 86, tilt: 1.5 },
  { key: "projects", href: "/projects", label: "projects", color: "var(--pink)", len: 82, tilt: -1 },
  { key: "about", href: "/about", label: "about", color: "var(--yellow)", len: 74, tilt: 2.5 },
];
const { active } = Astro.props;
---
<div class="ledge-fade" aria-hidden="true"></div>
<div class="ledge-wrap">
  <nav class="ledge" data-dock data-open="" aria-label="Site">
    <div class="wipe" id="ledge-links" data-panel="more">
      <p class="mono kicker">find me elsewhere</p>
      <ul>
        {socials.map((s, i) => (
          <li style={`--i:${i}`}>
            <a class="hand" href={s.href} rel={s.href.startsWith("http") ? "me noopener" : undefined}>{s.label} <span aria-hidden="true">↗</span></a>
          </li>
        ))}
      </ul>
      <p class="mono sign">© {new Date().getFullYear()} Gartha · written in chalk</p>
    </div>

    <ul class="sticks">
      {sticks.map((s, i) => (
        <li style={`--i:${i}`}>
          <a
            class="stick-link"
            href={s.href}
            data-scribble
            aria-current={s.key === active ? "page" : undefined}
            style={`--c:${s.color};--len:${s.len}px;--tilt:${s.tilt}deg`}
          >
            <span class="label hand">{s.label}</span>
            <span class="stick" aria-hidden="true"></span>
          </a>
        </li>
      ))}
    </ul>

    <button class="eraser" type="button" data-tray="more" aria-controls="ledge-links" aria-expanded="false" aria-label="Find me elsewhere">
      <span class="wood"></span>
      <span class="felt"></span>
    </button>

    <div class="tray" aria-hidden="true"></div>
  </nav>
</div>

<script>
  import { initDock } from "../scripts/dock";
  import { initScribbleNav } from "../scripts/scribble-nav";

  const root = document.querySelector<HTMLElement>("[data-dock]");
  if (root) {
    initDock(root);
    initScribbleNav(root);
  }
</script>

<style is:global>
  /* The scribble drawn across the board on the way to another page. */
  .scribble {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 100;
    pointer-events: none;
    fill: none;
    -webkit-mask-image: var(--grain);
    mask-image: var(--grain);
  }
  .scribble path {
    stroke-width: 9;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0.9;
    animation: scribble-draw 0.38s cubic-bezier(0.5, 0, 0.5, 1) forwards;
  }
  @keyframes scribble-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
</style>

<style>
  .ledge-fade {
    position: fixed;
    inset: auto 0 0;
    height: 130px;
    z-index: 40;
    pointer-events: none;
    background: linear-gradient(to bottom, transparent, rgba(30, 34, 32, 0.9));
  }
  .ledge-wrap {
    position: fixed;
    inset: auto 0 calc(10px + env(safe-area-inset-bottom));
    z-index: 50;
    display: flex;
    justify-content: center;
    padding: 0 12px;
    pointer-events: none;
  }
  .ledge {
    position: relative;
    display: flex;
    align-items: flex-end;
    gap: 6px;
    padding: 0 22px 16px;
    pointer-events: auto;
    animation: ledge-in 0.7s cubic-bezier(0.3, 1.3, 0.5, 1) 0.3s both;
  }

  /* The wooden tray the chalk rests on. */
  .tray {
    position: absolute;
    inset: auto 0 0;
    height: 18px;
    z-index: -1;
    border-radius: 3px 3px 6px 6px;
    background:
      repeating-linear-gradient(
        92deg,
        rgba(0, 0, 0, 0) 0 18px,
        rgba(0, 0, 0, 0.08) 18px 20px,
        rgba(0, 0, 0, 0) 20px 41px
      ),
      linear-gradient(to bottom, #a8774a 0 5px, #8a5c34 5px 7px, #74492a 7px 100%);
    box-shadow:
      0 -1px 0 rgba(255, 230, 200, 0.25) inset,
      0 8px 18px rgba(0, 0, 0, 0.5),
      0 -2px 10px rgba(243, 241, 231, 0.06);
  }
  /* Chalk dust settled along the tray. */
  .tray::before {
    content: "";
    position: absolute;
    inset: 0 6% auto;
    height: 5px;
    background: radial-gradient(ellipse at 30% 50%, rgba(243, 241, 231, 0.45), transparent 60%),
      radial-gradient(ellipse at 72% 50%, rgba(243, 241, 231, 0.35), transparent 55%);
    -webkit-mask-image: var(--grain);
    mask-image: var(--grain);
  }

  .sticks {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stick-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 4px 6px 0;
    color: var(--chalk-2);
    text-decoration: none;
  }
  .label {
    font-size: 19px;
    line-height: 1;
    text-shadow: var(--chalk-glow);
    transition:
      color 0.2s ease,
      transform 0.25s ease;
  }
  .stick {
    position: relative;
    display: block;
    width: var(--len);
    height: 13px;
    border-radius: 7px 4px 4px 7px / 7px 5px 5px 7px;
    background:
      linear-gradient(to bottom, rgba(255, 255, 255, 0.35), transparent 45%, rgba(0, 0, 0, 0.18)),
      var(--c);
    box-shadow: 0 3px 3px rgba(0, 0, 0, 0.35);
    transform: rotate(var(--tilt));
    -webkit-mask-image: var(--grain);
    mask-image: var(--grain);
    transition: transform 0.35s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .stick-link:hover .label,
  .stick-link:focus-visible .label {
    color: var(--chalk);
    transform: translateY(-2px);
  }
  .stick-link:hover .stick,
  .stick-link:focus-visible .stick {
    transform: translateY(-7px) rotate(calc(var(--tilt) - 6deg));
  }
  .stick-link:focus-visible {
    outline: none;
  }
  .stick-link:focus-visible .label {
    text-decoration: underline wavy var(--yellow);
    text-underline-offset: 5px;
  }

  /* You are here: this stick has been used the most, so it's worn short and
     propped up against the tray, and its name is in yellow. */
  .stick-link[aria-current="page"] .label {
    color: var(--yellow);
  }
  .stick-link[aria-current="page"] .stick {
    width: calc(var(--len) * 0.5);
    border-radius: 7px;
    transform: translateY(-5px) rotate(-14deg);
  }

  /* The felt eraser at the end of the tray. */
  .eraser {
    position: relative;
    flex-shrink: 0;
    width: 66px;
    height: 30px;
    margin: 0 0 1px 10px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    transform: rotate(-3deg);
    transition: transform 0.3s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .eraser .wood {
    position: absolute;
    inset: 0 0 11px;
    border-radius: 5px 5px 2px 2px;
    background:
      repeating-linear-gradient(90deg, transparent 0 9px, rgba(0, 0, 0, 0.1) 9px 10px),
      linear-gradient(to bottom, #c48d58, #9a6a3e);
  }
  .eraser .felt {
    position: absolute;
    inset: auto 0 0;
    height: 12px;
    border-radius: 2px 2px 4px 4px;
    background: linear-gradient(to bottom, #6f716c, #55574f);
    box-shadow: 0 0 0 1px rgba(243, 241, 231, 0.18) inset;
  }
  .eraser .felt::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(243, 241, 231, 0.5);
    -webkit-mask-image: var(--grain);
    mask-image: var(--grain);
    opacity: 0.6;
  }
  .eraser:hover {
    transform: translateY(-4px) rotate(-6deg);
  }
  .ledge[data-open="more"] .eraser {
    animation: scrub 0.6s ease-in-out;
  }

  /* The links tray: a freshly wiped patch of board above the eraser. */
  .wipe {
    position: absolute;
    right: 0;
    bottom: calc(100% + 14px);
    width: 270px;
    padding: 22px 26px 18px;
    box-sizing: border-box;
    display: none;
  }
  .ledge[data-open="more"] .wipe {
    display: block;
  }
  .wipe::before {
    content: "";
    position: absolute;
    inset: -28px -30px -20px -48px;
    z-index: -1;
    background:
      radial-gradient(ellipse at 55% 45%, rgba(243, 241, 231, 0.07), transparent 70%),
      #262b29;
    -webkit-mask-image: radial-gradient(closest-side, #000 78%, transparent 100%);
    mask-image: radial-gradient(closest-side, #000 78%, transparent 100%);
    animation: wipe 0.5s ease-out both;
  }
  .wipe .kicker {
    margin: 0 0 4px;
    font-size: 14px;
    color: var(--chalk-3);
  }
  .wipe ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .wipe a {
    display: inline-block;
    padding: 3px 0;
    font-size: 27px;
    color: var(--chalk);
    text-decoration: none;
    text-shadow: var(--chalk-glow);
  }
  .wipe a:hover {
    color: var(--yellow);
  }
  .wipe .sign {
    margin: 8px 0 0;
    font-size: 12px;
    color: var(--chalk-3);
  }
  .ledge[data-open="more"] .wipe li,
  .ledge[data-open="more"] .wipe .kicker,
  .ledge[data-open="more"] .wipe .sign {
    animation: chalk-in 0.5s ease-out calc(0.25s + var(--i, 0) * 0.12s) both;
  }

  @keyframes ledge-in {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
  }
  @keyframes scrub {
    0%,
    100% {
      transform: rotate(-3deg);
    }
    20% {
      transform: translate(-16px, -26px) rotate(-10deg);
    }
    40% {
      transform: translate(-40px, -40px) rotate(4deg);
    }
    60% {
      transform: translate(-12px, -30px) rotate(-8deg);
    }
    80% {
      transform: translate(-4px, -8px) rotate(-2deg);
    }
  }
  @keyframes wipe {
    from {
      clip-path: inset(0 0 0 100%);
      opacity: 0.4;
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes chalk-in {
    from {
      clip-path: inset(-20% 100% -20% 0);
    }
    to {
      clip-path: inset(-20% -5% -20% 0);
    }
  }

  @media (max-width: 520px) {
    .ledge {
      gap: 2px;
      padding: 0 12px 15px;
    }
    .stick-link {
      padding: 4px 3px 0;
    }
    .stick {
      width: calc(var(--len) * 0.68);
      height: 11px;
    }
    .label {
      font-size: 17px;
    }
    .eraser {
      width: 50px;
      height: 26px;
      margin-left: 6px;
    }
    .eraser .wood {
      inset: 0 0 10px;
    }
    .eraser .felt {
      height: 11px;
    }
    .wipe {
      width: min(270px, calc(100vw - 40px));
    }
  }
</style>
