---
import { formatDate, readTime } from "../lib/posts";
import type { CollectionEntry } from "astro:content";
interface Props {
  post: CollectionEntry<"blog">;
}
const { post } = Astro.props;
const mins = readTime(post.body ?? "");
---

<a class="row link-plain" href={`/blog/${post.id}`} data-category={post.data.category}>
  <time class="mono" datetime={formatDate(post.data.date)}>{formatDate(post.data.date)}</time>
  <div class="text">
    <h2 class="display">{post.data.title}</h2>
    <p>{post.data.description}</p>
    <span class="meta mono">{post.data.category} · {mins} min</span>
  </div>
</a>

<style>
  .row {
    display: grid;
    grid-template-columns: 130px minmax(0, 1fr);
    gap: 24px;
    padding: 26px 0;
    border-bottom: 1px dashed var(--chalk-faint);
    color: var(--chalk);
  }
  .row:hover {
    color: var(--chalk);
  }
  .row:hover h2 {
    color: var(--yellow);
  }
  time {
    padding-top: 10px;
    font-size: 15px;
    color: var(--chalk-3);
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  h2 {
    margin: 0;
    font-size: 30px;
    line-height: 1.15;
    text-wrap: pretty;
    transition: color 0.2s ease;
  }
  p {
    margin: 0;
    font-size: 20px;
    line-height: 1.4;
    color: var(--chalk-2);
  }
  .meta {
    font-size: 14px;
    color: var(--chalk-3);
  }
  @media (max-width: 640px) {
    .row {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    time {
      padding-top: 0;
    }
  }
</style>
