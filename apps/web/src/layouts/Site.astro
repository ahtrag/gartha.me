---
import "@gartha/ui/tokens.css";
import { Logo } from "@gartha/ui";
import { FONTS_HREF } from "../lib/fonts";
// Navigation: two designs are kept while choosing between them.
// The chalk ledge (wooden tray of chalk sticks) is switched off for now;
// to bring it back, uncomment these two Ledge lines and remove DrawnDock.
// import Ledge from "../components/Ledge.astro";
import DrawnDock from "../components/DrawnDock.astro";
interface Props {
  title: string;
  description?: string;
  active?: "home" | "blog" | "projects" | "about";
  wide?: boolean;
  /** Site-relative path to the link-preview image. */
  image?: string;
  type?: "website" | "article";
}
const { title, description, active = "home", wide = false, image = "/og.png", type = "website" } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const fullTitle = `${title} · gartha.me`;
const imageUrl = new URL(image, Astro.site).href;
const imageAlt = "Gartha, Software Engineer at Imajinyata. gartha.me";
const isHome = Astro.url.pathname === "/";
const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Gartha",
  url: "https://gartha.me",
  jobTitle: "Software Engineer",
  worksFor: { "@type": "Organization", name: "Imajinyata", url: "https://imajinyata.com" },
  sameAs: ["https://github.com/ahtrag"],
};
// Ragged bottom edge for the paper strip. A fixed seed keeps builds stable.
let seed = 7;
const rand = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);
const torn: string[] = ["0% 0%", "100% 0%"];
for (let x = 100; x >= 0; x -= 2.5) torn.push(`${x}% calc(100% - ${(rand() * 9).toFixed(1)}px)`);
const tornClip = `polygon(${torn.join(", ")})`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content="gartha.me" />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {isHome && <script type="application/ld+json" is:inline set:html={JSON.stringify(personLd)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={FONTS_HREF} />
    <style>
      .wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
      /* A small torn scrap of paper pinned at the top, carrying the mark. */
      .strip { position: relative; display: flex; justify-content: center; width: fit-content; margin: 0 auto; padding: 12px 34px 20px; background: var(--paper-strip); color: var(--paper-ink); box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35); transform: rotate(-1.2deg); animation: strip-in 0.8s cubic-bezier(0.3, 1.4, 0.5, 1) both; }
      .strip::before { content: ""; position: absolute; inset: 0; background: var(--grain); opacity: 0.12; mix-blend-mode: multiply; pointer-events: none; }
      .brand { display: flex; align-items: center; gap: 10px; color: var(--paper-ink); text-decoration: none; --logo-accent: #17886a; }
      .brand:hover { color: var(--paper-ink); }
      .brand span { font-size: 24px; line-height: 1; }
      .extra { display: flex; justify-content: flex-end; padding-top: 18px; }
      .extra:empty { display: none; }
      main { padding: 28px 0 150px; }
      @keyframes strip-in { from { opacity: 0; transform: translateY(-24px) rotate(-4deg); } }
    </style>
    <slot name="head" />
  </head>
  <body>
    <div class={wide ? "" : "wrap"}>
      <header class={wide ? "wrap" : ""}>
        <div class="strip" style={`clip-path:${tornClip}`}>
          <a class="brand" href="/" aria-label="gartha.me home">
            <Logo size={38} label="" />
            <span class="display" aria-hidden="true">gartha.me</span>
          </a>
        </div>
        <div class="extra"><slot name="header-right" /></div>
      </header>
      <main><slot /></main>
    </div>
    {/* <Ledge active={active} /> */}
    <DrawnDock active={active} />
    <script>
      import { initDust } from "../scripts/dust";
      initDust();
    </script>
  </body>
</html>
