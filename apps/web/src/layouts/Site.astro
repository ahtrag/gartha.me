---
import "@gartha/ui/tokens.css";
import { Logo } from "@gartha/ui";
import { FONTS_HREF } from "../lib/fonts";
import { socials } from "../data/profile";
interface Props {
  title: string;
  description?: string;
  active?: "home" | "blog" | "about";
  wide?: boolean;
}
const { title, description, active = "home", wide = false } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const nav: { key: NonNullable<Props["active"]>; href: string; label: string }[] = [
  { key: "home", href: "/", label: "Home" },
  { key: "blog", href: "/blog", label: "Blog" },
  { key: "about", href: "/about", label: "About" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · gartha.me</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={FONTS_HREF} />
    <style>
      .wrap { max-width: 1248px; margin: 0 auto; padding: 0 24px; }
      header { display: flex; align-items: center; justify-content: space-between; padding: 28px 0; gap: 16px; flex-wrap: wrap; }
      .brand { display: flex; align-items: center; gap: 14px; text-decoration: none; }
      nav { display: flex; gap: 10px; }
      nav a { height: 48px; padding: 0 22px; border-radius: var(--radius-md); display: flex; align-items: center; font-weight: 700; color: var(--muted); text-decoration: none; }
      nav a[aria-current="page"] { background: var(--paper); color: var(--blue); font-weight: 800; box-shadow: var(--shadow-card-sm); }
      main { padding-bottom: 64px; }
      footer { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding: 28px 0 40px; border-top: 2px solid var(--line); font-size: 14px; font-weight: 700; color: var(--muted); }
      footer ul { display: flex; gap: 8px; flex-wrap: wrap; margin: 0; padding: 0; list-style: none; }
      footer ul a { display: flex; align-items: center; height: 40px; padding: 0 16px; border-radius: var(--radius-md); background: var(--paper); box-shadow: var(--shadow-card-sm); font-weight: 800; text-decoration: none; }
    </style>
    <slot name="head" />
  </head>
  <body>
    <div class={wide ? "" : "wrap"}>
      <header class={wide ? "wrap" : ""}>
        <a class="brand" href="/">
          <Logo size={48} />
          <span class="display" style="font-size:26px;font-weight:800;color:var(--ink)">gartha.me</span>
        </a>
        <nav>
          {nav.map((n) => (
            <a href={n.href} aria-current={n.key === active ? "page" : undefined}>{n.label}</a>
          ))}
        </nav>
        <slot name="header-right" />
      </header>
      <main><slot /></main>
      <footer class={wide ? "wrap" : ""}>
        <span class="mono">© {new Date().getFullYear()} Gartha · gartha.me</span>
        <ul aria-label="Find me elsewhere">
          {socials.map((s) => (
            <li><a href={s.href} rel={s.href.startsWith("http") ? "me noopener" : undefined}>{s.label}</a></li>
          ))}
        </ul>
      </footer>
    </div>
  </body>
</html>
