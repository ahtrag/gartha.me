---
import Site from "../layouts/Site.astro";
---

<Site title="Not found">
  <section class="lost">
    <p class="mono kicker">404</p>
    <h1 class="display chalk">Someone wiped this part of the board.</h1>
    <p class="hand">The page you wanted isn't here anymore, or it never was.</p>
    <a class="hand" href="/">⟵ back home</a>
  </section>
</Site>

<style>
  .lost {
    max-width: 640px;
    margin: 72px auto;
    text-align: center;
  }
  .kicker {
    margin: 0;
    color: var(--chalk-3);
  }
  h1 {
    margin: 8px 0 16px;
    font-size: 54px;
    line-height: 1.05;
  }
  p {
    font-size: 22px;
    color: var(--chalk-2);
  }
  a {
    font-size: 24px;
  }
</style>
