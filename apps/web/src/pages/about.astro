---
// "Recent notes" is filled in per request by the Worker from D1.
import Site from "../layouts/Site.astro";
import RowTemplate from "../components/RowTemplate.astro";
import { Avatar } from "@gartha/ui";
import { profile, socials } from "../data/profile";
---

<Site title="About" description="About Gartha, a software engineer at Imajinyata who works with AI agents, writes up the setups that stick, and plays casual and classic games." active="about">
  <section class="hd">
    <div class="pic"><Avatar size={120} /></div>
    <div class="htext">
      <span class="mono kicker">a little about me</span>
      <h1 class="display chalk">About {profile.name}</h1>
      <p class="title">Software Engineer at <a href="https://imajinyata.com" rel="noopener">Imajinyata</a></p>
    </div>
  </section>

  <div class="cols">
    <div class="body">
      {profile.bio.map((p) => <p>{p}</p>)}
      <p class="find">
        Find me on {socials.map((s, i) => (
          <Fragment>{i > 0 && (i === socials.length - 1 ? " or " : ", ")}<a href={s.href} rel={s.href.startsWith("http") ? "me noopener" : undefined}>{s.label}</a></Fragment>
        ))}.
      </p>
    </div>
  </div>

  <Fragment set:html="<!--@if:recent-->" />
  <section class="recent">
    <h2 class="display recent-h">recent notes</h2>
    <div class="list"><Fragment set:html="<!--@rows-->" /></div>
  </section>
  <Fragment set:html="<!--@endif:recent-->" />
  <RowTemplate />
</Site>

<style>
  .hd {
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .pic {
    flex-shrink: 0;
  }
  .htext {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .kicker {
    font-size: 16px;
    color: var(--chalk-3);
  }
  h1 {
    margin: 0;
    font-size: 70px;
    line-height: 1;
  }
  .title {
    margin: 0;
    font-size: 24px;
    color: var(--sky);
  }
  .cols {
    max-width: 760px;
    margin-top: 44px;
  }
  .body {
    font-size: 22px;
    line-height: 1.6;
    color: var(--chalk-2);
  }
  .body p {
    margin: 0 0 20px;
    text-wrap: pretty;
  }
  .body p:last-child {
    margin-bottom: 0;
  }
  .find {
    color: var(--chalk-3);
  }
  .recent-h {
    margin: 0 0 4px;
    font-size: 30px;
    color: var(--yellow);
  }
  .recent {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 64px;
  }
  .list {
    border-top: 1px dashed var(--chalk-faint);
  }
  @media (max-width: 640px) {
    .hd {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
    h1 {
      font-size: 50px;
    }
    .body {
      font-size: 20px;
    }
  }
</style>
