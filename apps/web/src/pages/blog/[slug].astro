---
import { getCollection, render } from "astro:content";
import Site from "../../layouts/Site.astro";
import { Avatar, CategoryChip } from "@gartha/ui";
import { formatDate, neighbours, readTime, sortNewest } from "../../lib/posts";

export async function getStaticPaths() {
  const sorted = sortNewest(await getCollection("blog"));
  return sorted.map((post) => ({ params: { slug: post.id }, props: { post, ...neighbours(sorted, post.id) } }));
}
const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const published = formatDate(post.data.date);
const postingLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: published,
  url: new URL(Astro.url.pathname, Astro.site).href,
  author: { "@type": "Person", name: "Gartha", url: "https://gartha.me" },
  image: new URL("/og.png", Astro.site).href,
};
---

<Site title={post.data.title} description={post.data.description} active="blog" type="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={published} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(postingLd)} />
  </Fragment>
  <Fragment slot="header-right"><a class="back link-plain hand" href="/blog">⟵ back to the blog</a></Fragment>
  <div class="progress" data-progress aria-hidden="true"><span></span></div>
  <article data-article>
    <header class="hd">
      <div><CategoryChip category={post.data.category} /></div>
      <h1 class="display chalk">{post.data.title}</h1>
      <div class="by">
        <Avatar /><b>Gartha</b>
        <time class="mono" datetime={formatDate(post.data.date)}>{formatDate(post.data.date)}</time>
        <span class="mono">{readTime(post.body ?? "")} min read</span>
      </div>
    </header>
    <div class="body"><Content /></div>
    <nav class="pn">
      {
        prev ? (
          <a class="link-plain" href={`/blog/${prev.id}`}>
            <small class="mono"><span class="nudge" aria-hidden="true">⟵</span> previous</small>
            <b class="hand">{prev.data.title}</b>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a class="r link-plain" href={`/blog/${next.id}`}>
            <small class="mono">next <span class="nudge" aria-hidden="true">⟶</span></small>
            <b class="hand">{next.data.title}</b>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>
</Site>

<script>
  import { addCopyButtons, initProgress, markWhenSeen } from "../../scripts/reading";

  const article = document.querySelector<HTMLElement>("[data-article]");
  const bar = document.querySelector<HTMLElement>("[data-progress]");
  if (article && bar) initProgress(article, bar);
  const body = document.querySelector<HTMLElement>(".body");
  if (body) {
    markWhenSeen(body.querySelectorAll("h2, h3"));
    addCopyButtons(body);
  }
</script>

<style>
  /* Reading progress: a chalk line drawn across the top as you read. */
  .progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    height: 3px;
    pointer-events: none;
  }
  .progress span {
    display: block;
    height: 100%;
    background: var(--yellow);
    box-shadow: 0 0 6px rgba(245, 224, 126, 0.5);
    transform: scaleX(var(--p, 0));
    transform-origin: left;
    -webkit-mask-image: var(--grain);
    mask-image: var(--grain);
  }

  .back {
    font-size: 21px;
    color: var(--chalk-2);
  }
  .back:hover {
    color: var(--yellow);
  }
  article {
    max-width: 780px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  .hd {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-bottom: 26px;
    border-bottom: 2px dashed var(--chalk-faint);
  }
  h1 {
    margin: 0;
    font-size: 54px;
    line-height: 1.05;
    font-weight: 400;
    text-wrap: pretty;
    text-shadow: var(--chalk-glow);
  }
  .by {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    font-size: 15px;
    color: var(--chalk-3);
  }
  .by b {
    color: var(--chalk);
    font-weight: 400;
    font-size: 21px;
  }
  .body {
    font-size: 21px;
    line-height: 1.6;
    color: var(--chalk-2);
  }
  .body :global(p),
  .body :global(ul),
  .body :global(ol) {
    margin: 0 0 20px;
  }
  .body :global(li) {
    margin-bottom: 6px;
  }
  .body :global(h2),
  .body :global(h3) {
    font-family: var(--font-display);
    line-height: 1.15;
    color: var(--yellow);
    text-shadow: var(--chalk-glow);
    margin: 40px 0 12px;
  }
  .body :global(h2) {
    font-size: 36px;
  }
  .body :global(h3) {
    font-size: 28px;
  }
  .body :global(strong) {
    color: var(--chalk);
  }
  .body :global(blockquote) {
    margin: 0 0 20px;
    padding: 4px 0 4px 20px;
    border-left: 3px solid var(--pink);
    color: var(--chalk);
  }
  .body :global(:not(pre) > code) {
    padding: 1px 6px;
    border-radius: 4px;
    background: rgba(243, 241, 231, 0.1);
    color: var(--mint);
    font-size: 0.8em;
  }
  .body :global(pre) {
    margin: 0 0 24px;
    border: 2px solid var(--chalk-faint);
    border-radius: var(--sketch-radius);
    padding: 20px 22px;
    font-size: 15px;
    line-height: 1.65;
    overflow-x: auto;
  }
  .body :global(img) {
    max-width: 100%;
    height: auto;
  }
  .body :global(hr) {
    border: 0;
    border-top: 2px dashed var(--chalk-faint);
    margin: 32px 0;
  }
  /* Section headings get underlined in chalk as they come into view. */
  .body :global(h2),
  .body :global(h3) {
    position: relative;
    width: fit-content;
  }
  .body :global(h2)::after,
  .body :global(h3)::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 3px;
    border-radius: 2px;
    background: var(--yellow);
    opacity: 0.6;
    transform: scaleX(0) rotate(-0.6deg);
    transform-origin: left;
    transition: transform 0.7s cubic-bezier(0.6, 0, 0.3, 1) 0.1s;
    -webkit-mask-image: var(--grain);
    mask-image: var(--grain);
  }
  .body :global(h2.seen)::after,
  .body :global(h3.seen)::after {
    transform: scaleX(1) rotate(-0.6deg);
  }

  /* Links: the chalk underline thickens and brightens on hover. */
  .body :global(a) {
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 100% / 100% 1px no-repeat;
    padding-bottom: 1px;
    transition: background-size 0.25s ease, color 0.2s ease;
  }
  .body :global(a:hover) {
    background-size: 100% 2.5px;
    color: var(--chalk);
  }

  /* Copy button on code blocks. */
  /* The frame holds the copy button so it stays put while code scrolls. */
  .body :global(.code-wrap) {
    position: relative;
    margin: 0 0 24px;
  }
  .body :global(.code-wrap pre) {
    margin: 0;
  }
  .body :global(.copy) {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 4px 10px;
    border: 1.5px solid var(--chalk-faint);
    border-radius: var(--sketch-radius);
    background: rgba(36, 41, 39, 0.9);
    color: var(--chalk-3);
    font-size: 13px;
    cursor: pointer;
    opacity: 0;
    transition:
      opacity 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }
  .body :global(.code-wrap:hover .copy),
  .body :global(.copy:focus-visible) {
    opacity: 1;
  }
  .body :global(.copy:hover) {
    color: var(--chalk);
    border-color: var(--chalk-line);
  }
  .body :global(.copy.done) {
    opacity: 1;
    color: var(--mint);
    border-color: var(--mint);
    animation: copied 0.4s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  @keyframes copied {
    40% {
      transform: scale(1.12) rotate(-3deg);
    }
  }
  @media (hover: none) {
    .body :global(.copy) {
      opacity: 1;
    }
  }

  .nudge {
    display: inline-block;
    transition: transform 0.3s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .pn a:hover .nudge {
    transform: translateX(4px);
  }
  .pn a:not(.r):hover .nudge {
    transform: translateX(-4px);
  }
  .pn {
    border-top: 1px dashed var(--chalk-faint);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .pn a {
    padding: 18px 0 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    color: var(--chalk);
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .pn a:hover {
    color: var(--yellow);
  }
  .pn a.r {
    text-align: right;
  }
  .pn small {
    font-size: 14px;
    color: var(--chalk-3);
  }
  .pn b {
    font-weight: 400;
    font-size: 22px;
  }
  @media (max-width: 720px) {
    h1 {
      font-size: 40px;
    }
    .body {
      font-size: 20px;
    }
