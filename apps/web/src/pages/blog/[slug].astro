---
import { getCollection, render } from "astro:content";
import Site from "../../layouts/Site.astro";
import { Avatar, CategoryChip } from "@gartha/ui";
import { formatDate, neighbours, readTime, sortNewest } from "../../lib/posts";

export async function getStaticPaths() {
  const sorted = sortNewest(await getCollection("blog"));
  return sorted.map((post) => ({ params: { slug: post.id }, props: { post, ...neighbours(sorted, post.id) } }));
}
const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const published = formatDate(post.data.date);
const postingLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: published,
  url: new URL(Astro.url.pathname, Astro.site).href,
  author: { "@type": "Person", name: "Gartha", url: "https://gartha.me" },
  image: new URL("/og.png", Astro.site).href,
};
---

<Site title={post.data.title} description={post.data.description} active="blog" type="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={published} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(postingLd)} />
  </Fragment>
  <Fragment slot="header-right"><a class="back link-plain hand" href="/blog">⟵ back to the blog</a></Fragment>
  <article>
    <header class="hd">
      <div><CategoryChip category={post.data.category} /></div>
      <h1 class="display">{post.data.title}</h1>
      <div class="by">
        <Avatar /><b>Gartha</b>
        <time class="mono" datetime={formatDate(post.data.date)}>{formatDate(post.data.date)}</time>
        <span class="mono">{readTime(post.body ?? "")} min read</span>
      </div>
    </header>
    <div class="body"><Content /></div>
    <nav class="pn">
      {
        prev ? (
          <a class="link-plain" href={`/blog/${prev.id}`}>
            <small class="mono">previous</small>
            <b class="hand">{prev.data.title}</b>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a class="r link-plain" href={`/blog/${next.id}`}>
            <small class="mono">next</small>
            <b class="hand">{next.data.title}</b>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>
</Site>

<style>
  .back {
    font-size: 21px;
    color: var(--chalk-2);
  }
  .back:hover {
    color: var(--yellow);
  }
  article {
    max-width: 780px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  .hd {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-bottom: 26px;
    border-bottom: 2px dashed var(--chalk-faint);
  }
  h1 {
    margin: 0;
    font-size: 54px;
    line-height: 1.05;
    font-weight: 400;
    text-wrap: pretty;
    text-shadow: var(--chalk-glow);
  }
  .by {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    font-size: 15px;
    color: var(--chalk-3);
  }
  .by b {
    color: var(--chalk);
    font-weight: 400;
    font-size: 21px;
  }
  .body {
    font-size: 21px;
    line-height: 1.6;
    color: var(--chalk-2);
  }
  .body :global(p),
  .body :global(ul),
  .body :global(ol) {
    margin: 0 0 20px;
  }
  .body :global(li) {
    margin-bottom: 6px;
  }
  .body :global(h2),
  .body :global(h3) {
    font-family: var(--font-display);
    line-height: 1.15;
    color: var(--yellow);
    text-shadow: var(--chalk-glow);
    margin: 40px 0 12px;
  }
  .body :global(h2) {
    font-size: 36px;
  }
  .body :global(h3) {
    font-size: 28px;
  }
  .body :global(strong) {
    color: var(--chalk);
  }
  .body :global(blockquote) {
    margin: 0 0 20px;
    padding: 4px 0 4px 20px;
    border-left: 3px solid var(--pink);
    color: var(--chalk);
  }
  .body :global(:not(pre) > code) {
    padding: 1px 6px;
    border-radius: 4px;
    background: rgba(243, 241, 231, 0.1);
    color: var(--mint);
    font-size: 0.8em;
  }
  .body :global(pre) {
    margin: 0 0 24px;
    border: 2px solid var(--chalk-faint);
    border-radius: var(--sketch-radius);
    padding: 20px 22px;
    font-size: 15px;
    line-height: 1.65;
    overflow-x: auto;
  }
  .body :global(img) {
    max-width: 100%;
    height: auto;
  }
  .body :global(hr) {
    border: 0;
    border-top: 2px dashed var(--chalk-faint);
    margin: 32px 0;
  }
  .pn {
    border-top: 1px dashed var(--chalk-faint);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .pn a {
    padding: 18px 0 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    color: var(--chalk);
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .pn a:hover {
    color: var(--yellow);
  }
  .pn a.r {
    text-align: right;
  }
  .pn small {
    font-size: 14px;
    color: var(--chalk-3);
  }
  .pn b {
    font-weight: 400;
    font-size: 22px;
  }
  @media (max-width: 720px) {
    h1 {
      font-size: 40px;
    }
    .body {
      font-size: 20px;
    }
    .pn {
      grid-template-columns: 1fr;
    }
    .pn a.r {
      text-align: left;
    }
  }
</style>
