---
import { getCollection } from "astro:content";
import Site from "../../layouts/Site.astro";
import PostCard from "../../components/PostCard.astro";
import { sortNewest } from "../../lib/posts";

const all = sortNewest(await getCollection("blog"));
const cats = ["all", "code", "games", "builds"] as const;
---

<Site title="Blog" description="Notes on code, games, and builds." active="blog">
  <div class="head">
    <div>
      <span class="mono kicker">notes on the board</span>
      <h1 class="display chalk">Blog</h1>
    </div>
    <div class="filters" role="group" aria-label="Filter posts by category">
      {
        cats.map((c) => (
          <button class="hand" data-filter={c} aria-pressed={c === "all"}>
            {c}
          </button>
        ))
      }
    </div>
  </div>

  <div class="list">
    {all.map((p, i) => <PostCard post={p} index={i} />)}
  </div>
  <p class="empty" hidden>Nothing written in this corner of the board yet.</p>
</Site>

<script>
  import { applyFilter } from "../../scripts/filter";

  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const cards = document.querySelectorAll<HTMLElement>("[data-category]");
  const empty = document.querySelector<HTMLElement>(".empty");
  for (const b of buttons) {
    b.addEventListener("click", () => {
      applyFilter(buttons, cards, empty, b.dataset.filter ?? "all");
    });
  }
</script>

<style>
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .kicker {
    font-size: 16px;
    color: var(--chalk-3);
  }
  h1 {
    margin: 0;
    font-size: 76px;
    line-height: 1;
  }
  .filters {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .filters button {
    position: relative;
    height: 44px;
    padding: 0 14px;
    border: 0;
    background: none;
    color: var(--chalk-3);
    font-size: 23px;
    cursor: pointer;
    transition:
      color 0.15s ease,
      transform 0.15s ease;
  }
  .filters button:hover {
    color: var(--chalk);
  }
  /* The active filter gets circled in chalk. */
  .filters button[aria-pressed="true"] {
    color: var(--yellow);
  }
  /* The circle is drawn around the chosen filter, sweeping like a hand. */
  .filters button[aria-pressed="true"]::after {
    content: "";
    position: absolute;
    inset: 2px -2px;
    border: 2px solid var(--yellow);
    border-radius: 50% 45% 52% 48% / 55% 48% 52% 45%;
    transform: rotate(-3deg);
    -webkit-mask-image: conic-gradient(from 200deg, #000 var(--sweep), transparent 0);
    mask-image: conic-gradient(from 200deg, #000 var(--sweep), transparent 0);
    animation: ring-sweep 0.5s cubic-bezier(0.6, 0, 0.3, 1) both;
  }
  .filters button:active {
    transform: scale(0.94);
  }
  @property --sweep {
    syntax: "<angle>";
    inherits: false;
    initial-value: 360deg;
  }
  @keyframes ring-sweep {
    from {
      --sweep: 0deg;
    }
    to {
      --sweep: 360deg;
    }
  }
  .empty {
    margin: 36px 0 0;
    color: var(--chalk-3);
    text-align: center;
  }
  .list {
    margin-top: 28px;
    border-top: 1px dashed var(--chalk-faint);
  }
  @media (max-width: 640px) {
    h1 {
      font-size: 60px;
    }
  }
</style>
