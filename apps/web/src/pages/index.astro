---
import { getCollection } from "astro:content";
import Site from "../layouts/Site.astro";
import ChalkStage from "../components/ChalkStage.astro";
import { Button } from "@gartha/ui";
import { profile } from "../data/profile";
import { formatDate, readTime, sortNewest, wordCount } from "../lib/posts";

const posts = sortNewest(await getCollection("blog"));
const latest = posts[0];
const words = posts.reduce((n, p) => n + wordCount(p.body ?? ""), 0);
const readMins = posts.reduce((n, p) => n + readTime(p.body ?? ""), 0);
const compact = (n: number) => (n >= 1000 ? `${(n / 1000).toFixed(1)}k` : String(n));
const facts = [
  `${posts.length} posts`,
  `${compact(words)} words`,
  `${readMins} min of reading`,
  ...(latest ? [`last written ${formatDate(latest.data.date)}`] : []),
];
---
<Site title="Gartha · Software Engineer" description={profile.tagline} active="home">
  <section class="hero">
    <div class="profile">
      <h1 class="name display chalk">{profile.name}</h1>
      <svg class="underline" viewBox="0 0 300 18" aria-hidden="true"><path pathLength="1" d="M4 12 C 60 4 130 16 190 8 S 270 6 296 10" /></svg>
      <p class="title display">{profile.title}</p>
      <p class="intro">{profile.intro}</p>
      <div class="ctas">
        <Button href="/blog">read the blog</Button>
        <a class="more" href="/about">about me ⟶</a>
      </div>
      {latest && (
        <a class="latest link-plain" href={`/blog/${latest.id}`}>
          <span class="mono tag">latest note</span>
          <span class="arrow" aria-hidden="true">⟶</span>
          <b>{latest.data.title}</b>
        </a>
      )}
    </div>

    <ChalkStage />
  </section>

  <section class="facts mono" aria-label="At a glance">
    <p>{profile.stack.map((t) => t.value).join(" · ")}</p>
    <p>{facts.join(" · ")}</p>
  </section>
</Site>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 600px);
    gap: 32px;
    align-items: center;
  }
  .profile {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 480px;
  }
  /* Name: plain chalk lettering, written in left to right with an underline. */
  .name {
    margin: 0;
    font-size: 104px;
    line-height: 0.95;
    animation: hero-write 1.1s cubic-bezier(0.5, 0, 0.3, 1) 0.15s both;
  }
  .underline {
    width: 260px;
    height: 18px;
    margin-top: -14px;
    fill: none;
    stroke: var(--yellow);
    stroke-width: 3;
    stroke-linecap: round;
  }
  .underline path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: hero-draw 0.7s ease-out 0.8s forwards;
  }
  /* The rest of the intro settles in one line after another. */
  .profile > :nth-child(n + 3) {
    animation: hero-rise 0.7s ease-out both;
  }
  .profile > :nth-child(3) {
    animation-delay: 0.6s;
  }
  .profile > :nth-child(4) {
    animation-delay: 0.72s;
  }
  .profile > :nth-child(5) {
    animation-delay: 0.84s;
  }
  .profile > :nth-child(6) {
    animation-delay: 0.96s;
  }
  .facts {
    animation: hero-rise 0.7s ease-out 1.2s both;
  }
  @keyframes hero-write {
    from {
      clip-path: inset(-10% 100% -10% 0);
    }
    to {
      clip-path: inset(-10% -2% -10% 0);
    }
  }
  @keyframes hero-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  .title {
    margin: 0;
    font-size: 30px;
    color: var(--sky);
    text-shadow: var(--chalk-glow);
  }
  .intro {
    margin: 0;
    font-size: 21px;
    line-height: 1.45;
    color: var(--chalk-2);
    text-wrap: pretty;
  }
  .ctas {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
    margin-top: 6px;
  }
  .latest {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px 12px;
    margin-top: 14px;
    color: var(--chalk);
  }
  .latest .tag {
    font-size: 15px;
    color: var(--yellow);
  }
  .latest .arrow {
    color: var(--chalk-3);
    transition: transform 0.2s ease;
  }
  .latest b {
    font-weight: 400;
    font-size: 21px;
    text-decoration: underline wavy var(--chalk-faint);
    text-underline-offset: 6px;
  }
  .latest:hover .arrow {
    transform: translateX(4px);
  }
  .latest:hover b {
    color: var(--yellow);
    text-decoration-color: var(--yellow);
  }
  .more {
    align-self: center;
    font-size: 21px;
    color: var(--chalk-2);
    text-decoration: none;
  }
  .more:hover {
    color: var(--yellow);
  }
  .facts {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 40px;
    font-size: 15px;
    color: var(--chalk-3);
  }
  .facts p {
    margin: 0;
  }
  @media (max-width: 960px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .profile {
      max-width: none;
    }
  }
  @media (max-width: 720px) {
    .name {
      font-size: 76px;
    }
  }
</style>
