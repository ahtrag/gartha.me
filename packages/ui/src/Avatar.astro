---
// Gartha's face, cropped from the hero photo, ringed in chalk.
interface Props { size?: number; src?: string }
const { size = 40, src = "/gartha-head.webp" } = Astro.props;
---
<img src={src} alt="" width={size} height={size} style={`display:block;width:${size}px;height:${size}px;border-radius:50%;object-fit:cover;border:2px solid var(--chalk-line);box-sizing:border-box`} />
