---
// A chalk-colored tag with dark text, like a sticky label on the board.
interface Props { color?: string }
const { color = "var(--yellow)" } = Astro.props;
---
<span class="mono" style={`display:inline-block;padding:3px 12px;background:${color};color:var(--paper-ink);font-size:14px;letter-spacing:.06em;border-radius:var(--sketch-radius);transform:rotate(-2deg)`}><slot /></span>
