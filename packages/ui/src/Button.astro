---
interface Props { href: string; kind?: "primary" | "secondary"; disabled?: boolean }
const { href, kind = "primary", disabled = false } = Astro.props;
const cls = [
  "btn",
  kind === "secondary" ? "btn--secondary" : "",
  disabled ? "btn--disabled" : "",
]
  .filter(Boolean)
  .join(" ");
---
<a
  href={href}
  class={`hand ${cls}`}
  aria-disabled={disabled ? "true" : undefined}
  tabindex={disabled ? -1 : undefined}
><slot /></a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    padding: 0 26px;
    border: 2px solid var(--chalk);
    border-radius: var(--sketch-radius-pill);
    font-size: 22px;
    text-decoration: none;
    background: var(--chalk);
    color: var(--paper-ink);
    transition: transform 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }
  .btn:hover {
    color: var(--paper-ink);
    background: var(--yellow);
    border-color: var(--yellow);
    transform: rotate(-1.5deg);
  }
  .btn--secondary {
    background: transparent;
    color: var(--chalk);
    border-color: var(--chalk-line);
  }
  .btn--secondary:hover {
    background: transparent;
    color: var(--yellow);
    border-color: var(--yellow);
    transform: rotate(1.5deg);
  }
  .btn:active {
    transform: scale(0.97);
  }
  .btn--disabled {
    opacity: 0.5;
    pointer-events: none;
  }
</style>
