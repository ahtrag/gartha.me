---
interface Props {
  title?: string;
  tone?: "paper" | "blue" | "dark";
  class?: string;
  as?: "div" | "section" | "article";
}
const { title, tone = "paper", class: cls, as = "div" } = Astro.props as Props;
const bgByTone: Record<NonNullable<Props["tone"]>, string> = {
  paper: "var(--paper)",
  blue: "var(--blue)",
  dark: "var(--ink)",
};
const shadowByTone: Record<NonNullable<Props["tone"]>, string> = {
  paper: "var(--shadow-card)",
  blue: "0 8px 0 var(--blue-deep)",
  dark: "0 8px 0 var(--dark)",
};
const bg = bgByTone[tone];
const shadow = shadowByTone[tone];
const titleId = title
  ? `card-${title
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "")}`
  : undefined;
const Tag = as;
---
<Tag
  class={cls}
  style={`position:relative;padding:${title ? "42px 26px 24px" : "28px"};border-radius:var(--radius-lg);background:${bg};box-shadow:${shadow}`}
  aria-labelledby={titleId}
>
  {title && (
    <h2 id={titleId} class="display" style="margin:0;position:absolute;left:50%;top:-18px;transform:translateX(-50%);padding:8px 32px;border-radius:var(--radius-md);background:var(--bg-top);color:var(--ink-2);font-size:17px;font-weight:800;letter-spacing:.1em;white-space:nowrap">{title}</h2>
  )}
  <slot />
</Tag>
