---
// A chalk-drawn box. `tone` is kept for older callers: "paper" is a plain
// outline, "blue" and "dark" fill the box with a slightly lighter slate.
interface Props {
  title?: string;
  tone?: "paper" | "blue" | "dark";
  class?: string;
  as?: "div" | "section" | "article";
}
const { title, tone = "paper", class: cls, as = "div" } = Astro.props as Props;
const bg = tone === "paper" ? "transparent" : "var(--board-2)";
const titleId = title
  ? `card-${title
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "")}`
  : undefined;
const Tag = as;
---
<Tag
  class:list={["sketch", cls]}
  style={`position:relative;padding:26px 24px 22px;margin-top:${title ? "44px" : "0"};background:${bg}`}
  aria-labelledby={titleId}
>
  {title && (
    <h2 id={titleId} class="display" style="margin:0;position:absolute;left:6px;top:-44px;color:var(--yellow);font-size:28px;line-height:1.2;letter-spacing:.02em;white-space:nowrap;text-shadow:var(--chalk-glow)">{title}</h2>
  )}
  <slot />
</Tag>
