---
import type { Category } from "./types";
export type { Category } from "./types";
interface Props { category: Category }
const { category } = Astro.props;
const color = { code: "var(--sky)", games: "var(--pink)", builds: "var(--mint)" }[category];
---
<span class="mono" style={`display:inline-block;padding:2px 10px;border:1.5px solid ${color};color:${color};border-radius:var(--sketch-radius);font-size:14px`}>{category}</span>
