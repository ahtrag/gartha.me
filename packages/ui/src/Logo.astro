---
// The site mark: a chunky blue tile with a hard offset base and a stroked
// `</g>` glyph, the `g` in green. Drawn as paths (not text) so it needs no
// web font. apps/web/public/favicon.svg carries the same drawing with literal
// colors; keep the two in sync when changing the shape.
interface Props {
  size?: number;
  label?: string;
}
const { size = 48, label = "gartha.me" } = Astro.props;
---
<svg
  class="logo-mark"
  width={size}
  height={size}
  viewBox="0 0 64 64"
  role="img"
  aria-label={label}
  style="display:block;overflow:visible"
>
  <rect x="4" y="10" width="56" height="56" rx="16" fill="var(--blue-deep)"></rect>
  <rect x="4" y="4" width="56" height="56" rx="16" fill="var(--blue)"></rect>
  <g fill="none" stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M20 24 L12 32 L20 40" stroke="var(--paper)"></path>
    <path d="M29 22 L23 42" stroke="var(--paper)"></path>
    <path d="M46 24 L54 32 L46 40" stroke="var(--paper)"></path>
    <g data-glyph="g" stroke="var(--green)" stroke-width="4.5">
      <circle cx="37" cy="31" r="5"></circle>
      <path d="M42 27 V40 A5 5 0 0 1 32 40"></path>
    </g>
  </g>
</svg>
