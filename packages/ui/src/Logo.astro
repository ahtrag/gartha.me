---
// The site mark: a `</g>` glyph drawn in chalk strokes, the `g` in teal.
// Strokes use currentColor so the mark reads on the paper header and on the
// board alike. apps/web/public/favicon.svg carries the same drawing with
// literal colors; keep the two in sync when changing the shape.
interface Props {
  size?: number;
  label?: string;
}
const { size = 48, label = "gartha.me" } = Astro.props;
---
<svg
  class="logo-mark"
  width={size}
  height={size}
  viewBox="0 0 64 64"
  role={label ? "img" : undefined}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : "true"}
  style="display:block;overflow:visible"
>
  <g fill="none" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M17 22 L7 32.5 L17.5 42" stroke="currentColor"></path>
    <path d="M28 18 L21 46" stroke="currentColor"></path>
    <path d="M47 22 L57 32 L46.5 42.5" stroke="currentColor"></path>
    <g data-glyph="g" stroke="var(--logo-accent, var(--teal))" stroke-width="4">
      <circle cx="36" cy="30" r="5.5"></circle>
      <path d="M41.5 25 V40 A5.5 5.5 0 0 1 31 41"></path>
    </g>
  </g>
</svg>
