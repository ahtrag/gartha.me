---
interface Props { label: string; value: string; color: string }
const { label, value, color } = Astro.props;
---
<div style="display:flex;align-items:baseline;gap:12px">
  <span aria-hidden="true" style={`color:${color};font-family:var(--font-type);font-size:15px;min-width:28px`}><slot /></span>
  <span class="mono" style="font-size:14px;color:var(--chalk-3);letter-spacing:.04em">{label}</span>
  <span aria-hidden="true" style="flex:1;border-bottom:2px dotted var(--chalk-faint);transform:translateY(-5px)"></span>
  <span class="hand" style={`font-size:24px;color:${color}`}>{value}</span>
</div>
